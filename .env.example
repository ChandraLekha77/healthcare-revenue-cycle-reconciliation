# Copy this file to .env for local Docker Compose usage.
# Replace the placeholder password in .env; never commit .env.
POSTGRES_DB=healthcare_revenue_cycle
POSTGRES_USER=healthcare_app
POSTGRES_PASSWORD=replace_with_a_strong_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
LOG_LEVEL=INFO
